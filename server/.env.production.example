# Runtime settings for the API host. Keep real values in the host's secret manager.
NODE_ENV=production
PORT=4000
CLIENT_URL=https://store.example.com
DATABASE_URL=postgresql://USER:PASSWORD@DATABASE_HOST:5432/aurelia_store
DATABASE_SSL=true
JWT_SECRET=replace-with-a-random-secret-at-least-32-characters
JWT_EXPIRES_IN=7d
